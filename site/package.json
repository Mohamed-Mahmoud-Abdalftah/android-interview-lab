{
  "name": "android-interview-mastery-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "sync": "python3 ../scripts/import_interview_lab.py && node scripts/sync-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "node --check public/scripts/interview-lab.js && node --check public/scripts/lab-state.mjs && node --check public/sw.js && node --check scripts/sync-interview-lab.mjs",
    "typecheck": "astro check",
    "predev": "pnpm sync",
    "dev": "astro dev",
    "prebuild": "pnpm sync && pnpm test",
    "build": "astro build",
    "postbuild": "node scripts/prefix-base.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "pnpm build && pnpm check:dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "typescript": "^6.0.3"
  }
}
