---
import academy from '../data/academy.json';
const lessons = [...academy.lessons].sort((a, b) => a.day - b.day);
---
<ol class="timeline" aria-label="مسار الدراسة على 48 يوم">
  {lessons.map((lesson) => (
    <li class="timeline-item" data-ready={lesson.status === 'reviewed'}>
      <div class="timeline-day">يوم <bdi>{lesson.day}</bdi></div>
      <div>
        {lesson.route ? <a href={lesson.route}><strong><bdi>{lesson.id}</bdi> — {lesson.title}</strong></a> : <strong><bdi>{lesson.id}</bdi> — {lesson.title}</strong>}
        <div>الأسبوع {Math.ceil(lesson.day / 6)} · ساعتين · المتطلبات: {lesson.prerequisites.length ? lesson.prerequisites.join('، ') : 'لا يوجد'}</div>
      </div>
      <span class:list={['status-chip', lesson.status === 'reviewed' ? '' : 'planned']}>{lesson.status === 'reviewed' ? 'جاهز للمذاكرة' : 'لسه بيتكتب'}</span>
    </li>
  ))}
</ol>
